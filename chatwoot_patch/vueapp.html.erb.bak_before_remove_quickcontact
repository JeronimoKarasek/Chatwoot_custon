  function bindModalEvents(modal) {
    // Close btn
    modal.querySelector('#fc-qc-close-btn').addEventListener('click', closeModal);
    modal.querySelector('#fc-qc-cancel-btn').addEventListener('click', closeModal);

    // Inbox change -> toggle template/message sections
    var inboxSel = modal.querySelector('#fc-qc-inbox');
    inboxSel.addEventListener('change', onInboxChange);

    // Template search filter
    var tplSearch = modal.querySelector('#fc-qc-tpl-search');
    if (tplSearch) {
      tplSearch.addEventListener('input', function() {
        filterTemplates(tplSearch.value);
      });
    }

    // Send
    modal.querySelector('#fc-qc-send-btn').addEventListener('click', handleSend);

    // Esc key
    document.addEventListener('keydown', function escHandler(e) {
      if (e.key === 'Escape') {
        closeModal();
        document.removeEventListener('keydown', escHandler);
      }
    });
  }

  var currentTemplates = [];
  var selectedTemplate = null;

  async function onInboxChange() {
    var sel = document.getElementById('fc-qc-inbox');
    var inboxId = sel.value;
    var tplSection = document.getElementById('fc-qc-template-section');
    var msgSection = document.getElementById('fc-qc-msg-section');
    var tplList = document.getElementById('fc-qc-tpl-list');
    var tplSearch = document.getElementById('fc-qc-tpl-search');

    currentTemplates = [];
    selectedTemplate = null;

    if (!inboxId) {
      tplSection.style.display = 'none';
      msgSection.style.display = '';
      return;
    }

    var opt = sel.options[sel.selectedIndex];
    var chType = opt.dataset.channelType;
    var isEvo = isEvolutionInbox(inboxId);
    var isWA = chType === 'Channel::Whatsapp';
    var isTwilioWA = chType === 'Channel::TwilioSms'; // Could be WhatsApp via Twilio

    if (isEvo || isWA || isTwilioWA) {
      // Show template selector
      tplSection.style.display = '';
      tplList.innerHTML = '<div style="padding:12px;text-align:center;color:#94a3b8;">Carregando templates...</div>';
      try {
        currentTemplates = await fetchTemplates(inboxId);
        renderTemplates(currentTemplates);
      } catch(e) {
        tplList.innerHTML = '<div style="padding:12px;text-align:center;color:#991b1b;">Erro ao carregar templates</div>';
      }
      // For Evolution, show message field too (can send without template)
      if (isEvo) {
        msgSection.style.display = '';
        document.getElementById('fc-qc-tpl-help').textContent = 'Selecione um template OU envie uma mensagem livre abaixo.';
      } else {
        // WhatsApp Cloud / Twilio WA: require template for first message
        msgSection.style.display = 'none';
        document.getElementById('fc-qc-tpl-help').textContent = 'Para a primeira mensagem via WhatsApp, selecione um template.';
      }
    } else {
      tplSection.style.display = 'none';
      msgSection.style.display = '';
    }

    if (tplSearch) tplSearch.value = '';
  }

  function renderTemplates(templates) {
    var tplList = document.getElementById('fc-qc-tpl-list');
    if (!templates || templates.length === 0) {
      tplList.innerHTML = '<div style="padding:12px;text-align:center;color:#94a3b8;">Nenhum template encontrado</div>';
      return;
    }
    tplList.innerHTML = '';
    templates.forEach(function(tpl) {
      var bodyComp = (tpl.components || []).find(function(c) { return c.type === 'BODY'; });
      var bodyText = bodyComp ? bodyComp.text : '';
      var item = document.createElement('div');
      item.className = 'fc-tpl-item';
      item.dataset.tplId = tpl.id || tpl.name;
      item.innerHTML = '<div class="fc-tpl-name">' + escapeHtml(tpl.name) + '</div>' +
                        (bodyText ? '<div class="fc-tpl-body">' + escapeHtml(bodyText) + '</div>' : '');
      item.addEventListener('click', function() {
        // Deselect others
        tplList.querySelectorAll('.fc-tpl-item').forEach(function(el) { el.classList.remove('selected'); });
        item.classList.add('selected');
        selectedTemplate = tpl;
        // If evolution, also prefill message
        var msgEl = document.getElementById('fc-qc-message');
        if (msgEl && bodyText) msgEl.value = bodyText;
      });
      tplList.appendChild(item);
    });
  }

  function filterTemplates(query) {
    var q = query.toLowerCase();
    var filtered = currentTemplates.filter(function(tpl) {
      return tpl.name.toLowerCase().indexOf(q) !== -1;
    });
    renderTemplates(filtered);
  }

  function escapeHtml(str) {
    var div = document.createElement('div');
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
  }

  function showFeedback(msg, type) {
    var area = document.getElementById('fc-qc-feedback-area');
    if (!area) return;
    area.innerHTML = '<div class="fc-qc-feedback ' + type + '">' + escapeHtml(msg) + '</div>';
    if (type === 'success') {
      setTimeout(function() { if (area) area.innerHTML = ''; }, 4000);
    }
  }

  async function handleSend() {
    var name = (document.getElementById('fc-qc-name').value || '').trim();
    var phone = (document.getElementById('fc-qc-phone').value || '').trim().replace(/[\s\-\(\)]/g, '');
    var inboxId = document.getElementById('fc-qc-inbox').value;
    var message = (document.getElementById('fc-qc-message').value || '').trim();

    // Validations
    if (!name) { showFeedback('Preencha o nome do contato.', 'error'); return; }
    if (!phone) { showFeedback('Preencha o telefone.', 'error'); return; }
    if (!inboxId) { showFeedback('Selecione uma caixa de entrada.', 'error'); return; }

    var opt = document.getElementById('fc-qc-inbox').options[document.getElementById('fc-qc-inbox').selectedIndex];
    var chType = opt.dataset.channelType;
    var isEvo = isEvolutionInbox(inboxId);
    var isWA = chType === 'Channel::Whatsapp';
    var isTwilioWA = chType === 'Channel::TwilioSms';

    // For WA Cloud, require template; for Evolution, allow message or template
    if ((isWA || isTwilioWA) && !isEvo && !selectedTemplate) {
      showFeedback('Selecione um template WhatsApp para a primeira mensagem.', 'error');
      return;
    }
    if (!isWA && !isTwilioWA && !isEvo && !message) {
      showFeedback('Digite uma mensagem.', 'error');
      return;
    }
    if (isEvo && !message && !selectedTemplate) {
      showFeedback('Digite uma mensagem ou selecione um template.', 'error');
      return;
    }

    var sendBtn = document.getElementById('fc-qc-send-btn');
    sendBtn.disabled = true;
    sendBtn.innerHTML = '<span class="fc-qc-loading"></span>Processando...';

    try {
      // Step 1: Create or find contact
      showFeedback('Criando contato...', 'success');
      var contact = await createContact(name, phone);
      var contactId = contact.id;

      // Step 2: Get contactable inboxes to find sourceId
      showFeedback('Vinculando à caixa de entrada...', 'success');
      var contactableInboxes = await getContactableInboxes(contactId);
      var sourceId = null;
      for (var i = 0; i < contactableInboxes.length; i++) {
        if (contactableInboxes[i].inbox && contactableInboxes[i].inbox.id === Number(inboxId)) {
          sourceId = contactableInboxes[i].source_id;
          break;
        }
      }

      // Step 3: Create conversation with message
      showFeedback('Criando conversa...', 'success');
      var msgContent = message || '';
      var tplParams = null;

      if (selectedTemplate) {
        var bodyComp = (selectedTemplate.components || []).find(function(c) { return c.type === 'BODY'; });
        msgContent = bodyComp ? bodyComp.text : selectedTemplate.name;
        tplParams = {
          name: selectedTemplate.name,
          category: selectedTemplate.category || 'utility',
          language: (selectedTemplate.language || 'pt_BR'),
          namespace: selectedTemplate.namespace || '',
          processed_params: {}
        };
      }

      var conversation = await createConversation(contactId, Number(inboxId), sourceId, msgContent, tplParams);

      showFeedback('✅ Conversa criada com sucesso!', 'success');

      // Navigate to conversation
      var acctId = getAccountId();
      var convId = conversation.id || (conversation.data && conversation.data.id);
      if (acctId && convId) {
        setTimeout(function() {
          window.location.href = '/app/accounts/' + acctId + '/conversations/' + convId;
          closeModal();
        }, 800);
      } else {
        setTimeout(closeModal, 1500);
      }

    } catch(e) {
      showFeedback('Erro: ' + (e.message || 'Falha ao processar'), 'error');
      sendBtn.disabled = false;
      sendBtn.innerHTML = 'Criar e Enviar';
    }
  }

  // ===== BUTTON INJECTION =====
  function injectQuickContactButton() {
    // Find the compose conversation button (pen-line icon) in sidebar
    var penBtns = document.querySelectorAll('button');
    var composeBtn = null;
    for (var i = 0; i < penBtns.length; i++) {
      // The compose button has the i-lucide-pen-line icon
      var icon = penBtns[i].querySelector('.i-lucide-pen-line');
      if (icon) { composeBtn = penBtns[i]; break; }
    }
    if (!composeBtn) return;

    // Check if already injected
    var parent = composeBtn.parentElement;
    if (!parent) return;
    if (parent.querySelector('#fc-qc-trigger-btn')) return;

    // Detect collapsed state
    var isCollapsed = composeBtn.classList.contains('!size-8');

    // Create the + button
    var btn = document.createElement('button');
    btn.id = 'fc-qc-trigger-btn';
    btn.className = 'fc-qc-btn' + (isCollapsed ? ' fc-collapsed' : '');
    btn.title = 'Contato Rápido + Mensagem';
    btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>';
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      openQuickContactModal();
    });

    // Insert after compose button
    if (composeBtn.nextSibling) {
      parent.insertBefore(btn, composeBtn.nextSibling);
    } else {
      parent.appendChild(btn);
    }
  }

  // ===== INIT =====
  function init() {
    injectQuickContactStyles();
    // Poll for sidebar render
    setInterval(function() {
      if (!document.getElementById('fc-qc-trigger-btn')) {
        injectQuickContactButton();
      }
    }, 2000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
    </script>

    <div id="app"></div>
    <noscript id="noscript">This app works best with JavaScript enabled.</noscript>
    <%= yield %>
    <% if @dashboard_scripts.present? %>
      <%= @dashboard_scripts.html_safe %>
    <% end %>
  </body>
</html>
