  async function loadInboxOptions() {
    var sel = document.getElementById('fc-qc-inbox');
    if (!sel) return;
    try {
      var inboxes = await fetchInboxes();
      sel.innerHTML = '<option value="">Selecione uma caixa de entrada</option>';
      inboxes.forEach(function(inbox) {
        // Only show messaging channels
        var chType = inbox.channel_type || '';
        if (['Channel::Api','Channel::Whatsapp','Channel::TwilioSms','Channel::WebWidget','Channel::Sms','Channel::Telegram','Channel::Line','Channel::FacebookPage','Channel::Instagram','Channel::Email'].indexOf(chType) === -1) return;
        var opt = document.createElement('option');
        opt.value = inbox.id;
        var label = inbox.name;
        if (chType === 'Channel::Api' && isEvolutionInbox(inbox.id)) label += ' (Evolution)';
        else if (chType === 'Channel::Whatsapp') label += ' (WhatsApp Cloud)';
        else if (chType === 'Channel::Email') label += ' (Email)';
        else if (chType === 'Channel::TwilioSms') label += ' (Twilio)';
        opt.textContent = label;
        opt.dataset.channelType = chType;
        sel.appendChild(opt);
      });
    } catch(e) {
      sel.innerHTML = '<option value="">Erro ao carregar caixas</option>';
    }
