  // ===== HELPERS =====
  function getAccountId() {
    var m = window.location.pathname.match(/\/accounts\/(\d+)/);
    return m ? m[1] : null;
  }

  function getAuthToken() {
    var cookies = document.cookie.split(';');
    for (var i = 0; i < cookies.length; i++) {
      var c = cookies[i].trim();
      if (c.startsWith('cw_d_session_info=') || c.startsWith('access_token=') || c.startsWith('user_access_token=')) {
        try {
          var val = decodeURIComponent(c.split('=').slice(1).join('='));
          var parsed = JSON.parse(val);
          if (parsed && parsed.access_token) return parsed.access_token;
        } catch(e) {}
      }
    }
    // Fallback: try auth header from Chatwoot store
    try {
      var store = window.__vue_store__ || (document.querySelector('#app') && document.querySelector('#app').__vue_app__ && document.querySelector('#app').__vue_app__.config.globalProperties.$store);
      if (store && store.getters && store.getters['auth/getCurrentUser']) {
        return store.getters['auth/getCurrentUser'].access_token;
      }
    } catch(e) {}
    return null;
  }

  function apiHeaders() {
    var token = getAuthToken();
    var h = { 'Content-Type': 'application/json' };
    if (token) h['api_access_token'] = token;
    return h;
  }

  function isEvolutionInbox(inboxId) {
    return window.__evolutionInboxIds && window.__evolutionInboxIds.has(Number(inboxId));
  }

  // ===== CACHED DATA =====
  var cachedInboxes = null;
  var cachedInboxesTime = 0;

  async function fetchInboxes() {
    var acctId = getAccountId();
    if (!acctId) return [];
    var now = Date.now();
    if (cachedInboxes && (now - cachedInboxesTime) < 30000) return cachedInboxes;
    try {
      var resp = await fetch('/api/v1/accounts/' + acctId + '/inboxes', { headers: apiHeaders() });
      var data = await resp.json();
      cachedInboxes = (data && data.payload) ? data.payload : [];
      cachedInboxesTime = now;
      return cachedInboxes;
    } catch(e) { return cachedInboxes || []; }
  }

  async function fetchTemplates(inboxId) {
    // Templates are embedded in inbox data
    var inboxes = await fetchInboxes();
    for (var i = 0; i < inboxes.length; i++) {
      if (inboxes[i].id === Number(inboxId)) {
        var tpls = inboxes[i].message_templates ||
                   (inboxes[i].additional_attributes && inboxes[i].additional_attributes.message_templates) || [];
        // Filter approved templates
        return Array.isArray(tpls) ? tpls.filter(function(t) { return t.status === 'approved' || !t.status; }) : [];
      }
    }
    return [];
  }

  async function createContact(name, phone) {
    var acctId = getAccountId();
    if (!acctId) throw new Error('Conta não encontrada');
    var payload = { name: name };
    if (phone) payload.phone_number = phone.startsWith('+') ? phone : '+' + phone;
    var resp = await fetch('/api/v1/accounts/' + acctId + '/contacts', {
      method: 'POST', headers: apiHeaders(), body: JSON.stringify(payload)
    });
    if (!resp.ok) {
      var err = await resp.json().catch(function() { return {}; });
      // If contact already exists, try searching
      if (resp.status === 422 && phone) {
        return await findContactByPhone(phone);
      }
      throw new Error(err.message || 'Erro ao criar contato');
    }
    var data = await resp.json();
    return data.payload ? data.payload.contact : data;
  }

  async function findContactByPhone(phone) {
    var acctId = getAccountId();
    var q = phone.startsWith('+') ? phone : '+' + phone;
    var resp = await fetch('/api/v1/accounts/' + acctId + '/contacts/search?q=' + encodeURIComponent(q) + '&include_contact_inboxes=false', {
      headers: apiHeaders()
    });
    var data = await resp.json();
    if (data.payload && data.payload.length > 0) return data.payload[0];
    throw new Error('Contato com esse telefone já existe mas não foi encontrado');
  }

  async function getContactableInboxes(contactId) {
    var acctId = getAccountId();
    var resp = await fetch('/api/v1/accounts/' + acctId + '/contacts/' + contactId + '/contactable_inboxes', {
      headers: apiHeaders()
    });
    var data = await resp.json();
    return (data && data.payload) ? data.payload : [];
  }

  async function createConversation(contactId, inboxId, sourceId, message, templateParams) {
    var acctId = getAccountId();
    var payload = {
      inbox_id: inboxId,
      contact_id: contactId,
      message: { content: message }
    };
    if (sourceId) payload.source_id = sourceId;
    if (templateParams) payload.message.template_params = templateParams;
    // Try to assign to current user
    try {
      var store = document.querySelector('#app').__vue_app__.config.globalProperties.$store;
      if (store && store.getters['getCurrentUser']) {
        payload.assignee_id = store.getters['getCurrentUser'].id;
      }
    } catch(e) {}
    var resp = await fetch('/api/v1/accounts/' + acctId + '/conversations', {
      method: 'POST', headers: apiHeaders(), body: JSON.stringify(payload)
    });
    if (!resp.ok) {
      var err = await resp.json().catch(function() { return {}; });
      throw new Error(err.message || err.error || 'Erro ao criar conversa');
    }
    return await resp.json();
  }

