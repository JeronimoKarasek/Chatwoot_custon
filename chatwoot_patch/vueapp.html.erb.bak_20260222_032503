  // --- Detect if current inbox is Evolution via Chatwoot API ---
  async function fetchInboxData(accountId, inboxId) {
    try {
      var r = await authFetch('/api/v1/accounts/' + accountId + '/inboxes/' + inboxId);
      if (!r.ok) return null;
      return await r.json();
    } catch(e) { return null; }
  }

  // --- Main inbox settings page detection ---
  async function checkInboxConfigPage() {
    var match = window.location.pathname.match(/\/accounts\/(\d+)\/settings\/inboxes\/(\d+)/);
    if (!match) {
      cleanupEvoSettings();
      return;
    }

    var accountId = match[1];
    var inboxId = match[2];

    // Already injected for this inbox
    if (evoSettingsState.injected && evoSettingsState.inboxId === inboxId) return;

    // Fetch inbox data from Chatwoot API to check if Evolution
    var inboxData = await fetchInboxData(accountId, inboxId);
    if (!inboxData) return;

    // Check if this is an Evolution inbox (Channel::Api or legacy Channel::Whatsapp)
    var isEvolution = false;
    var instanceName = null;

    // Method 1: Check provider_config.provider_type (from _inbox_slim jbuilder)
    if (inboxData.provider_config) {
      if (inboxData.provider_config.provider_type === 'evolution') {
        isEvolution = true;
      }
    }

    // Method 2: Check additional_attributes for Channel::Api
    if (!isEvolution && inboxData.additional_attributes) {
      if (inboxData.additional_attributes.provider_type === 'evolution') {
        isEvolution = true;
        instanceName = inboxData.additional_attributes.instance_name;
      }
    }

    // Method 3: Fallback - check provider_config for instance_name
    if (!instanceName && inboxData.provider_config) {
      instanceName = inboxData.provider_config.instance_name;
    }

    // Method 4: Check provider attribute
    if (!isEvolution && inboxData.provider === 'evolution') {
      isEvolution = true;
    }

    if (!isEvolution || !instanceName) {
      console.log('[Evolution Settings] Inbox ' + inboxId + ' is not Evolution');
      return;
    }

    console.log('[Evolution Settings] Detected Evolution inbox ' + inboxId + ' instance: ' + instanceName);
    evoSettingsState.injected = true;
    evoSettingsState.inboxId = inboxId;
    evoSettingsState.instanceName = instanceName;

    // Wait for page to render then inject panel
    setTimeout(function() { injectEvoSettingsPanel(instanceName); }, 800);
  }

  function cleanupEvoSettings() {
    if (evoSettingsState.statusInterval) clearInterval(evoSettingsState.statusInterval);
    if (evoSettingsState.qrInterval) clearInterval(evoSettingsState.qrInterval);
    evoSettingsState.injected = false;
    evoSettingsState.inboxId = null;
    evoSettingsState.instanceName = null;
    var panel = document.getElementById('evo-settings-panel');
    if (panel) panel.remove();
  }

  function injectEvoSettingsPanel(instanceName) {
    if (document.getElementById('evo-settings-panel')) return;

    // Find Configuration tab content area - target the main section inside Settings.vue
    var target = document.querySelector('div.settings section.mx-auto') ||
                 document.querySelector('div.settings section') ||
                 document.querySelector('.settings--content') ||
                 document.querySelector('section.mx-auto') ||
                 document.querySelector('.column.content-box') ||
                 document.querySelector('.columns .column');

    if (!target) {
      console.log('[Evolution Settings] No settings container found, retrying...');
      setTimeout(function() { injectEvoSettingsPanel(instanceName); }, 1000);
      return;
    }

    var panel = document.createElement('div');
    panel.id = 'evo-settings-panel';
    panel.innerHTML = buildEvoSettingsHTML(instanceName);
    
    // Insert at the top of the settings content
    target.insertBefore(panel, target.firstChild);

    // Hide irrelevant WhatsApp Cloud settings (webhook token, API key, template sync)
    hideDefaultWhatsAppSettings();

    // Load data
    refreshEvoStatus(instanceName);
    loadEvoProfileData(instanceName);
    loadEvoProxyData(instanceName);

    // Auto-refresh status every 10s
    evoSettingsState.statusInterval = setInterval(function() {
      refreshEvoStatus(instanceName);
    }, 10000);
  }

  function hideDefaultWhatsAppSettings() {
    // Hide the default WhatsApp Cloud configuration sections that are irrelevant for Evolution
    // These include: webhook verify token, API key, update API key, sync templates
    setTimeout(function() {
      // Find sections with WhatsApp Cloud-specific content
      var codeSections = document.querySelectorAll('woot-code, .whatsapp-settings--content');
      codeSections.forEach(function(el) {
        // Walk up to find the SettingsSection parent and hide it
        var parent = el.closest('.mx-8 > div, .mx-8 > section, [class*="SettingsSection"]');
        if (parent) parent.style.display = 'none';
      });

      // Also hide template sync section
      var allButtons = document.querySelectorAll('button');
      allButtons.forEach(function(btn) {
        if (btn.textContent && btn.textContent.includes('Sync')) {
          var section = btn.closest('.mx-8 > div, [class*="SettingsSection"]');
          if (section) section.style.display = 'none';
        }
      });

      // Add a CSS rule to hide woot-code parents in the config tab when Evolution panel is present
      if (!document.getElementById('evo-hide-cloud-css')) {
        var style = document.createElement('style');
        style.id = 'evo-hide-cloud-css';
        style.textContent = '#evo-settings-panel ~ div .whatsapp-settings--content { display: none !important; }';
        document.head.appendChild(style);
      }
    }, 500);
  }

