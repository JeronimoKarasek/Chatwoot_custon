  window.evoDeleteProfilePicture = async function() {
    var ok = await evoRemoveProfilePicture(evoSettingsState.instanceName);
    showEvoFeedback(ok ? 'Foto removida!' : 'Erro ao remover foto', ok);
    if (ok) {
      var img = document.getElementById('evo-profile-img');
      var ph = document.getElementById('evo-profile-img-placeholder');
      if (img) { img.src = ''; img.style.display = 'none'; }
      if (ph) ph.style.display = 'flex';
    }
  };

  // --- Proxy functions ---
  async function evoFetchProxy(inst) {
    try {
      var r = await evoApi('/proxy/find/' + encodeURIComponent(inst));
      if (r.ok) return await r.json();
      return null;
    } catch(e) { return null; }
  }

  async function evoSetProxy(inst, proxyData) {
    var r = await evoApi('/proxy/set/' + encodeURIComponent(inst), {
      method: 'POST', body: JSON.stringify(proxyData)
    });
    return r.ok;
  }

  window.evoSaveProxy = async function() {
    var inst = evoSettingsState.instanceName;
    if (!inst) return;

    var enabled = document.getElementById('evo-proxy-enabled').checked;
    var host = document.getElementById('evo-proxy-host').value.trim();
    var port = document.getElementById('evo-proxy-port').value.trim();
    var protocol = document.getElementById('evo-proxy-protocol').value;
    var username = document.getElementById('evo-proxy-username').value.trim();
    var password = document.getElementById('evo-proxy-password').value.trim();

    if (enabled && (!host || !port)) {
      return showEvoFeedback('Host e Porta são obrigatórios', false);
    }

    var proxyData = { enabled: enabled, host: host, port: port, protocol: protocol, username: username, password: password };
    var ok = await evoSetProxy(inst, proxyData);
    showEvoFeedback(ok ? 'Proxy salvo com sucesso!' : 'Erro ao salvar proxy', ok);
  };

  async function loadEvoProxyData(instanceName) {
    try {
      var proxy = await evoFetchProxy(instanceName);
      if (proxy) {
        var enabledEl = document.getElementById('evo-proxy-enabled');
        var hostEl = document.getElementById('evo-proxy-host');
        var portEl = document.getElementById('evo-proxy-port');
        var protocolEl = document.getElementById('evo-proxy-protocol');
        var usernameEl = document.getElementById('evo-proxy-username');
        var passwordEl = document.getElementById('evo-proxy-password');
        var labelEl = document.getElementById('evo-proxy-enabled-label');

        if (enabledEl) { enabledEl.checked = proxy.enabled || false; }
        if (hostEl) hostEl.value = proxy.host || '';
        if (portEl) portEl.value = proxy.port || '';
        if (protocolEl) protocolEl.value = proxy.protocol || 'http';
        if (usernameEl) usernameEl.value = proxy.username || '';
        if (passwordEl) passwordEl.value = proxy.password || '';
        if (labelEl) labelEl.textContent = proxy.enabled ? 'Ativado' : 'Desativado';

        if (enabledEl) {
          enabledEl.addEventListener('change', function() {
            if (labelEl) labelEl.textContent = enabledEl.checked ? 'Ativado' : 'Desativado';
          });
        }
      }
    } catch(e) {
      console.log('[Evolution Settings] Proxy load error:', e);
    }
  }

  function showEvoFeedback(text, success) {
    var el = document.getElementById('evo-feedback');
    if (!el) return;
    el.textContent = text;
    el.style.display = 'block';
    el.style.background = success ? '#065f46' : '#7f1d1d';
    el.style.color = success ? '#a7f3d0' : '#fecaca';
    setTimeout(function() { el.style.display = 'none'; }, 4000);
  }

  async function loadEvoProfileData(instanceName) {
    try {
      var profile = await evoFetchProfile(instanceName);
      if (profile) {
        var nameEl = document.getElementById('evo-profile-name');
        var statusEl = document.getElementById('evo-profile-status');
        var displayName = document.getElementById('evo-profile-display-name');
        var displayStatus = document.getElementById('evo-profile-display-status');
        if (profile.name) {
          if (nameEl) nameEl.value = profile.name;
          if (displayName) displayName.textContent = profile.name;
        }
        if (profile.status) {
          if (statusEl) statusEl.value = profile.status;
          if (displayStatus) displayStatus.textContent = profile.status;
        }
        if (profile.isBusiness !== undefined) {
          if (displayStatus) displayStatus.textContent = (profile.status || '') + (profile.isBusiness ? ' (Business)' : '');
        }
      }
    } catch(e) {
      console.log('[Evolution Settings] Profile load error:', e);
    }

    // Try to load profile picture
    try {
      var inst = instanceName;
      var r = await evoApi('/chat/fetchProfilePictureUrl/' + encodeURIComponent(inst), {
        method: 'POST', body: JSON.stringify({ number: inst })
      });
      var d = await r.json();
      var picUrl = d.profilePictureUrl || d.picture || null;
      if (picUrl) {
        var img = document.getElementById('evo-profile-img');
        var ph = document.getElementById('evo-profile-img-placeholder');
        if (img) { img.src = picUrl; img.style.display = 'block'; }
        if (ph) ph.style.display = 'none';
      }
    } catch(e) {}
  }
  // ===== END EVOLUTION INBOX SETTINGS =====
  
  function init() {
    injectStyles();
    
    // Inject Evolution provider card on new inbox page
    setInterval(function() {
      if (!isInjected || !document.querySelector('[data-provider="evolution"]')) {
        isInjected = false;
        injectEvolutionProvider();
      }
    }, 1000);

    // Check for inbox config page (async, runs on URL change)
    var lastUrl = '';
    function checkRoute() {
      var currentUrl = window.location.href;
      if (currentUrl !== lastUrl) {
        lastUrl = currentUrl;
        // Reset injection state on navigation
        isInjected = false;
        cleanupEvoSettings();
        setTimeout(injectEvolutionProvider, 500);
        // Check if we're on an inbox settings page
        setTimeout(function() { checkInboxConfigPage(); }, 1200);
      }
    }
    
    // Initial check
    checkRoute();
    
    // Poll for URL changes (SPA routing)
    setInterval(checkRoute, 1500);
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
    </script>

    <!-- Evolution: Detect Evolution inbox IDs from API responses -->
    <script>
(function() {
  // Store Evolution inbox IDs detected from API responses
  window.__evolutionInboxIds = new Set();

  const originalFetch = window.fetch;
  window.fetch = function(...args) {
    return originalFetch.apply(this, args).then(function(response) {
      const url = (typeof args[0] === 'string') ? args[0] : (args[0]?.url || '');

      // Intercept inboxes list to detect Evolution inbox IDs
      if (/\/api\/v1\/accounts\/\d+\/inboxes\/?(\?|$)/.test(url) && !url.includes('contactable_inboxes')) {
        const cloned = response.clone();
        cloned.json().then(function(data) {
          if (data && data.payload) {
            data.payload.forEach(function(inbox) {
              // Detect Channel::Api Evolution inboxes
              if (inbox.channel_type === 'Channel::Api' &&
                  inbox.provider_config &&
                  inbox.provider_config.provider_type === 'evolution') {
                window.__evolutionInboxIds.add(inbox.id);
              }
              // Fallback: legacy Channel::Whatsapp Evolution inboxes
              if (inbox.channel_type === 'Channel::Whatsapp' &&
                  inbox.provider_config &&
                  inbox.provider_config.provider_type === 'evolution') {
                window.__evolutionInboxIds.add(inbox.id);
              }
            });
          }
        }).catch(function() {});
        return response;
      }

      return response;
    });
  };
})();
    </script>


    <!-- FarolChat Billing Page Enhancement v2 -->
    <script type="text/javascript">
// ===== FarolChat Billing Page Enhancement v2 =====
// Shows Usuários/Conexões cards with usage bars on billing page
// Uses XHR interception - NO independent API calls (no 401 errors)
(function() {
  'use strict';

  var billingInjected = false;
  var capturedLimits = null;

  // ---- Intercept XHR to capture limits response ----
  var _origXHROpen = XMLHttpRequest.prototype.open;
  var _origXHRSend = XMLHttpRequest.prototype.send;

  XMLHttpRequest.prototype.open = function(method, url) {
    this._farolUrl = url;
    return _origXHROpen.apply(this, arguments);
  };

  XMLHttpRequest.prototype.send = function() {
    var xhr = this;
    if (xhr._farolUrl && xhr._farolUrl.indexOf('/limits') !== -1 &&
        xhr._farolUrl.indexOf('/enterprise/') !== -1) {
      xhr.addEventListener('load', function() {
        try {
          var data = JSON.parse(xhr.responseText);
          if (data && data.limits) {
            capturedLimits = data.limits;
            setTimeout(function() { tryRenderPanel(); }, 500);
          }
        } catch(e) {}
      });
    }
    return _origXHRSend.apply(this, arguments);
  };

  function isBillingPage() {
    return window.location.href.indexOf('/settings/billing') !== -1;
  }

  function injectStyles() {
    if (document.getElementById('farol-billing-css')) return;
    var s = document.createElement('style');
    s.id = 'farol-billing-css';
    s.textContent = [
      '.farol-bp{background:var(--w-25,#f8fafc);border:1px solid var(--s-75,#e2e8f0);border-radius:12px;padding:20px;margin-top:16px}',
      '.dark .farol-bp{background:var(--w-600,#1e293b);border-color:var(--s-200,#334155)}',
      '.farol-bp-t{font-size:15px;font-weight:600;margin:0 0 16px;color:var(--s-900,#0f172a)}',
      '.dark .farol-bp-t{color:var(--s-50,#f8fafc)}',
      '.farol-bp-g{display:grid;grid-template-columns:1fr 1fr;gap:12px}',
      '@media(max-width:640px){.farol-bp-g{grid-template-columns:1fr}}',
      '.farol-bp-c{background:var(--w-50,#fff);border:1px solid var(--s-75,#e2e8f0);border-radius:8px;padding:16px}',
      '.dark .farol-bp-c{background:var(--w-700,#0f172a);border-color:var(--s-200,#334155)}',
      '.farol-bp-l{font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--s-600,#475569);margin-bottom:8px}',
      '.dark .farol-bp-l{color:var(--s-400,#94a3b8)}',
      '.farol-bp-v{font-size:28px;font-weight:700;color:var(--s-900,#0f172a)}',
      '.dark .farol-bp-v{color:var(--s-50,#f8fafc)}',
      '.farol-bp-v span{font-size:16px;font-weight:400;opacity:.5}',
      '.farol-bp-s{font-size:13px;color:var(--s-500,#64748b);margin-top:4px}',
      '.farol-bp-b{height:6px;background:var(--s-100,#e2e8f0);border-radius:3px;margin-top:10px;overflow:hidden}',
      '.dark .farol-bp-b{background:var(--s-700,#334155)}',
      '.farol-bp-bf{height:100%;border-radius:3px;transition:width .3s ease}',
      '.farol-bp-h{font-size:12px;color:var(--s-500,#64748b);margin-top:12px;text-align:center}'
    ].join('\n');
    document.head.appendChild(s);
  }

  function tryRenderPanel() {
    if (!isBillingPage()) return;
    if (document.getElementById('farol-billing-panel')) return;

    var limits = capturedLimits;
    if (!limits) {
      // Try to parse from DOM as fallback
      parseLimitsFromDOM();
      return;
    }

    renderPanel(limits);
  }

  function parseLimitsFromDOM() {
    // Look for "X Usuários • Y Conexões" in the page
    var allText = document.querySelectorAll('span, p, div');
    for (var i = 0; i < allText.length; i++) {
      var el = allText[i];
      if (el.children.length === 0) {
        var t = el.textContent.trim();
        var m = t.match(/(\d+)\s*Usu[aá]rios?\s*[•·]\s*(\d+)\s*Conex[oõ]es?/i);
        if (m) {
          var agents = parseInt(m[1], 10);
          var inboxes = parseInt(m[2], 10);
          renderPanel({
            agents: { allowed: agents, consumed: 0 },
            inboxes: { allowed: inboxes, consumed: 0 }
          });
          return;
        }
      }
    }
  }

  function renderPanel(limits) {
    if (document.getElementById('farol-billing-panel')) return;

    var ag = limits.agents || {};
    var ib = limits.inboxes || {};
    var aA = ag.allowed || 0, aC = ag.consumed || 0;
    var iA = ib.allowed || 0, iC = ib.consumed || 0;
    var aP = aA > 0 ? Math.min((aC / aA) * 100, 100) : 0;
    var iP = iA > 0 ? Math.min((iC / iA) * 100, 100) : 0;
    var aColor = aP >= 90 ? '#ef4444' : aP >= 70 ? '#f59e0b' : '#10b981';
    var iColor = iP >= 90 ? '#ef4444' : iP >= 70 ? '#f59e0b' : '#10b981';

    var panel = document.createElement('div');
    panel.id = 'farol-billing-panel';
    panel.className = 'farol-bp';
    panel.innerHTML = [
      '<h3 class="farol-bp-t">Detalhes da Assinatura</h3>',
      '<div class="farol-bp-g">',
      '<div class="farol-bp-c">',
      '  <div class="farol-bp-l">\uD83D\uDC64 Usu\u00E1rios (Agentes)</div>',
      '  <div class="farol-bp-v">' + aC + ' <span>/ ' + aA + '</span></div>',
      '  <div class="farol-bp-s">' + aC + ' em uso de ' + aA + ' liberados \u2022 R$ 29,00/m\u00EAs cada</div>',
      '  <div class="farol-bp-b"><div class="farol-bp-bf" style="width:' + aP + '%;background:' + aColor + '"></div></div>',
      '</div>',
      '<div class="farol-bp-c">',
      '  <div class="farol-bp-l">\uD83D\uDCF1 Conex\u00F5es (Caixas de Entrada)</div>',
      '  <div class="farol-bp-v">' + iC + ' <span>/ ' + iA + '</span></div>',
      '  <div class="farol-bp-s">' + iC + ' em uso de ' + iA + ' liberadas \u2022 R$ 49,90/m\u00EAs cada</div>',
      '  <div class="farol-bp-b"><div class="farol-bp-bf" style="width:' + iP + '%;background:' + iColor + '"></div></div>',
      '</div>',
      '</div>',
      '<div class="farol-bp-h">Para alterar quantidades, clique em "Ir para o portal de cobran\u00E7a" acima. Pagamento via PIX, boleto ou cart\u00E3o.</div>'
    ].join('\n');

    // Find insertion point - after the billing card
    var inserted = false;
    // Look for the "Current Plan" / "Plano atual" card
    var sections = document.querySelectorAll('section, .billing-item, [class*="billing"]');
    if (sections.length === 0) sections = document.querySelectorAll('.grid, .flex');
    
    for (var i = 0; i < sections.length; i++) {
      var sec = sections[i];
      // Check if this section/element contains billing content
      if (sec.textContent.indexOf('Profissional') !== -1 || 
          sec.textContent.indexOf('portal de cobran') !== -1 ||
          sec.textContent.indexOf('Manage subscription') !== -1 ||
          sec.textContent.indexOf('assinatura') !== -1) {
        sec.parentElement.insertBefore(panel, sec.nextSibling);
        inserted = true;
        break;
      }
    }

    if (!inserted) {
      // Deeper search - find any content-box
      var contentBox = document.querySelector('.column.content-box') || 
                       document.querySelector('[class*="content"]') ||
                       document.querySelector('main');
      if (contentBox) {
        // Insert after the first child div/section
        var firstChild = contentBox.querySelector('section, .grid, > div');
        if (firstChild) {
          firstChild.parentElement.insertBefore(panel, firstChild.nextSibling);
          inserted = true;
        }
      }
    }

    if (!inserted) {
      var appDiv = document.querySelector('#app');
      if (appDiv) {
        // Find the deepest content area
        var deepest = appDiv.querySelector('.column.content-box') || appDiv;
        deepest.appendChild(panel);
      }
    }

    // Replace labels
    setTimeout(replaceLabels, 200);
  }

  function replaceLabels() {
    var allEls = document.querySelectorAll('span, p, div, label, h4, h5, h6');
    for (var i = 0; i < allEls.length; i++) {
      var el = allEls[i];
      if (el.children.length === 0) {
        var txt = el.textContent.trim();
        if (txt === 'N\u00FAmero de assentos' || txt === 'Seat Count') {
          el.textContent = 'Assinatura';
        }
      }
    }
  }

  // ---- Page monitoring ----
  var lastUrl = '';
  function monitor() {
    var cur = window.location.href;
    if (cur !== lastUrl) {
      lastUrl = cur;
      billingInjected = false;
      var old = document.getElementById('farol-billing-panel');
      if (old) old.remove();
      capturedLimits = null;
    }

    if (!isBillingPage()) { billingInjected = false; return; }
    if (billingInjected && document.getElementById('farol-billing-panel')) {
      replaceLabels();
      return;
    }

    var hasContent = document.querySelector('.grid, section, [class*="billing"]');
    if (!hasContent) return;

    billingInjected = true;
    injectStyles();

    // Wait for XHR response, then try to render
    setTimeout(function() {
      tryRenderPanel();
      replaceLabels();
    }, 1500);
  }

  setInterval(monitor, 2000);
  if (document.readyState !== 'loading') {
    setTimeout(monitor, 3000);
  } else {
    document.addEventListener('DOMContentLoaded', function() {
      setTimeout(monitor, 3000);
    });
  }
})();

    </script>
